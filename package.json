{
  "name": "mqtt",
  "version": "0.1.0",
  "description": "MQTT 5 client preview for Node and browsers",
  "keywords": [
    "mqtt",
    "publish",
    "subscribe",
    "publish-subscribe",
    "publish/subscribe",
    "client",
    "broker",
    "server"
  ],
  "homepage": "https://github.com/dvkam/mqtt#readme",
  "bugs": "https://github.com/dvkam/mqtt/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvkam/mqtt.git"
  },
  "author": {
    "name": "David Kaminski",
    "url": "https://github.com/dvkam"
  },
  "contributors": [
    {
      "name": "mqttjs-v5 contributors",
      "url": "https://github.com/mqttjs/mqttjs-v5/graphs/contributors"
    },
    {
      "name": "MQTT.js contributors",
      "url": "https://github.com/mqttjs/MQTT.js/graphs/contributors"
    }
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:types": "tsc --emitDeclarationOnly && tsc -p test/types/tsconfig.json && tsc -p test/types/consumer/tsconfig.json && tsc --emitDeclarationOnly --outDir .type-fixtures/browser-api && tsc -p test/types/browser/tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "oxlint -c oxlint.config.mjs --deny-warnings --report-unused-disable-directives src test sample lint verification vitest.config.ts oxlint.config.mjs oxfmt.config.mjs && node lint/typePolicy.ts",
    "lint:policy": "node lint/typePolicy.ts",
    "format": "oxfmt -c oxfmt.config.mjs src test sample lint verification vitest.config.ts oxlint.config.mjs oxfmt.config.mjs",
    "format:check": "oxfmt -c oxfmt.config.mjs --check src test sample lint verification vitest.config.ts oxlint.config.mjs oxfmt.config.mjs"
  },
  "dependencies": {
    "mqtt-packet": "9.0.2",
    "pino": "10.4.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "pino-pretty": "13.2.0",
    "playwright": "1.65.0",
    "typescript": "7.1.0-beta",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
