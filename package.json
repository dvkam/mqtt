{
  "//": "TODO: author, contributors",
  "name": "mqtt",
  "version": "5.0.0",
  "description": "The next generation of the MQTT.js client",
  "keywords": [
    "mqtt",
    "publish",
    "subscribe",
    "publish-subscribe",
    "publish/subscribe",
    "client",
    "broker",
    "server"
  ],
  "homepage": "https://github.com/mqttjs/mqttjs-v5#readme",
  "bugs": "https://github.com/mqttjs/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.json && tsc -p test/types/consumer/tsconfig.json && tsc --emitDeclarationOnly --outDir .type-fixtures/browser-api && tsc -p test/types/browser/tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "oxlint -c oxlint.config.mjs --deny-warnings --report-unused-disable-directives src test vitest.config.ts oxlint.config.mjs oxfmt.config.mjs",
    "format": "oxfmt -c oxfmt.config.mjs src test vitest.config.ts oxlint.config.mjs oxfmt.config.mjs",
    "format:check": "oxfmt -c oxfmt.config.mjs --check src test vitest.config.ts oxlint.config.mjs oxfmt.config.mjs"
  },
  "dependencies": {
    "duplexify": "4.1.3",
    "end-of-stream": "1.4.5",
    "mqtt-packet": "9.0.2",
    "number-allocator": "1.0.14",
    "pino": "10.4.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/duplexify": "3.6.5",
    "@types/end-of-stream": "1.4.4",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "aedes": "1.2.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "pino-pretty": "13.2.0",
    "playwright": "1.65.0",
    "typescript": "7.1.0-beta",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
