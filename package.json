{
  "//": "TODO: author, contributors",
  "name": "mqtt",
  "version": "5.0.0",
  "description": "The next generation of the MQTT.js client",
  "keywords": [
    "mqtt",
    "publish",
    "subscribe",
    "publish-subscribe",
    "publish/subscribe",
    "client",
    "broker",
    "server"
  ],
  "homepage": "https://github.com/mqttjs/mqttjs-v5#readme",
  "bugs": "https://github.com/mqttjs/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=14.13.1"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.json",
    "lint": "oxlint --deny-warnings src test vitest.config.ts",
    "format": "oxfmt src test vitest.config.ts",
    "format:check": "oxfmt --check src test vitest.config.ts"
  },
  "dependencies": {
    "duplexify": "^4.1.2",
    "end-of-stream": "^1.4.4",
    "mqtt-packet": "^7.1.1",
    "number-allocator": "^1.0.10",
    "pino": "^7.6.3",
    "ws": "^8.4.2"
  },
  "devDependencies": {
    "@types/duplexify": "^3.6.1",
    "@types/end-of-stream": "^1.4.1",
    "@types/node": "26.6.6",
    "@types/ws": "^8.2.2",
    "aedes": "^0.46.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "pino-pretty": "^7.5.0",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
