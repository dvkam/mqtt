{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "/trace.js": ["./packed/browser.mjs"],
      "/probe.js": ["./packed/websocket-browser.mjs"],
      "/session.js": ["./packed/websocket-session.mjs"],
      "/streams.js": ["./packed/stream-comparison.ts"],
      "/receive.js": ["./packed/receive-client.ts"]
    }
  },
  "include": [
    "./*.test.ts",
    "./packed/*.mjs",
    "./packed/*.ts",
    "./experiments/*.ts",
    "./bench/*.mjs",
    "./bench/*.ts",
    "../sample/*.ts",
    "../lint/*.ts",
    "../verification/*.ts"
  ]
}
